{
  "name": "hopefelt-foundation-backend",
  "version": "2.0.0",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node server.js",
    "start:gateway": "node gateway/server.js",
    "dev": "nodemon server.js",
    "dev:gateway": "nodemon gateway/server.js",
    "dev:all": "concurrently -n api,gateway \"npm:dev\" \"npm:dev:gateway\"",
    "migrate": "node scripts/migrate.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "http-proxy-middleware": "^4.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-socket": "^0.2.17",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  }
}
