# ---------- Server ----------
NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call the API (your Next.js site)
CORS_ORIGIN=http://localhost:3000

# Reverse-proxy hops in front of the API (1 = the gateway)
TRUST_PROXY=1

# ---------- PostgreSQL (Supabase works: Project Settings -> Database -> Connection string) ----------
SUPABASE_URL=ads
SUPABASE_SERVICE_ROLE_KEY=asd

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=hf:

# ---------- JWT (REQUIRED in production, >= 32 random chars each, all different) ----------
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET= asd
JWT_REFRESH_SECRET= asd
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
JWT_ISSUER=hopefelt-api
JWT_AUDIENCE=hopefelt-web

# Refresh-token cookie. Cross-site frontend/API in production => COOKIE_SAMESITE=none + COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.hopefeltfoundation.org

# ---------- API Gateway ----------
GATEWAY_PORT=8080
API_UPSTREAM_URL=http://localhost:5000
GATEWAY_TRUST_PROXY=0
# Shared secret between gateway and API (>= 32 chars in production)
GATEWAY_SECRET=
# When true the API refuses any request that did not come through the gateway
REQUIRE_GATEWAY=false

# ---------- Auth hardening ----------
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SEC=900

# ---------- Rate limits (max requests / window seconds) ----------
# RL_GLOBAL_MAX=300      RL_GLOBAL_WINDOW=900
# RL_LOGIN_MAX=10        RL_LOGIN_WINDOW=900
# RL_REGISTER_MAX=5      RL_REGISTER_WINDOW=3600
# RL_CONTACT_MAX=5       RL_CONTACT_WINDOW=3600
# RL_APPLY_MAX=10        RL_APPLY_WINDOW=3600

# ---------- First admin (used by `npm run seed:admin`) ----------
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=ChangeMe-Str0ng-Pass
